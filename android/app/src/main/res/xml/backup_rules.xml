<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for Android 11 (API 30) and lower.
  Secure storage (session cookies) is excluded - it is encrypted with a
  device-bound KeyStore key, so it can never be decrypted after a restore.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
</full-backup-content>
