<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 12 (API 31) and higher.
  Secure storage (session cookies) is excluded - it is encrypted with a
  device-bound KeyStore key, so it can never be decrypted after a restore.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </device-transfer>
</data-extraction-rules>
